# Local development environment variables
# Copy to .env.local and fill in the values from `npm run supabase:status`

# Supabase (local) — printed by `npm run supabase:status`
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Public site URL (used for callbacks and CORS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Delivery dispatch (server-only). Required for automatic courier dispatch:
#   SUPABASE_SERVICE_ROLE_KEY — privileged writes from jobs/webhooks (from
#     `npm run supabase:status`). Server-only; never expose to the client.
#   JOBS_PROCESS_SECRET — bearer token guarding the /api/jobs/process drainer.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
JOBS_PROCESS_SECRET=any-long-random-string

# Optional: Mapbox public token for the checkout drop-off map picker
# (URL-restricted public token). When unset, checkout falls back to browser
# geolocation + manual coordinate entry — no map.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Payment provider credentials are NOT set here. The active gateway and its keys
# are configured from the admin dashboard and stored in the database
# (payment_settings). Locally this uses Stripe test keys.
