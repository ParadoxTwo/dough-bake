# Production environment variables (for Vercel / production deployment)

# Supabase (production) — from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# Service role key — required only by the seed/migration helper scripts
# (scripts/run-migrations-production.sh, scripts/seed-admin-user-production.*).
# Keep it secret; it is not used by the running app.
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Public site URL (used for callbacks and CORS)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Payment provider credentials are NOT set here. The active gateway and its keys
# are configured from the admin dashboard and stored in the database
# (payment_settings). Production uses live Stripe keys.
</content>
