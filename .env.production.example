# Production environment variables (for Vercel / production deployment)

# Supabase (production) — from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-production-anon-key

# Service role key — used by the seed/migration helper scripts AND by the app's
# delivery dispatch (queue processing + webhooks write via the service role).
# Server-only; keep it secret and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Public site URL (used for callbacks and CORS)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Bearer token guarding the /api/jobs/process queue drainer. Set the same value
# as Vercel's CRON_SECRET so scheduled cron invocations are authorized.
JOBS_PROCESS_SECRET=a-long-random-secret

# Optional: Mapbox public token for the checkout drop-off map picker
# (URL-restricted public token). When unset, checkout falls back to browser
# geolocation + manual coordinate entry.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Payment provider credentials are NOT set here. The active gateway and its keys
# are configured from the admin dashboard and stored in the database
# (payment_settings). Production uses live Stripe keys.
</content>
